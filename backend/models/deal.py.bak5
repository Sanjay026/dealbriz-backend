"""
DealLock models: offers in chat, the locked deal, and its timeline.

Tables come from ddb/migration_deallock_phase1.sql. Two columns in that file
are generated by MySQL and deliberately NOT mapped here, so SQLAlchemy never
tries to write them:

    deal_offers.live_key        one open offer per buyer per listing
    deals.active_product_id     one live deal per listing

Both back a UNIQUE index, so the database itself refuses a duplicate even if
two requests race. The routes turn that IntegrityError into a 409.
"""
from datetime import datetime

from extensions import db
from .base import gen_id, iso_utc


# Offer states. "open" is the only one that can still be acted on.
OFFER_OPEN = "open"
OFFER_COUNTERED = "countered"
OFFER_ACCEPTED = "accepted"
OFFER_DECLINED = "declined"
OFFER_EXPIRED = "expired"
OFFER_SUPERSEDED = "superseded"
OFFER_WITHDRAWN = "withdrawn"

# Deal states, in the order the design moves through them.
#   awaiting_seller   the offer was accepted. The buyer accepts the deal
#                     warning, then the seller confirms (warning + SMS OTP),
#                     each within CONFIRM_HOURS. No other buyer can start a
#                     deal on the listing, but it isn't shown as Reserved.
#   docs_pending      the seller confirmed. Both sides upload documents
#                     (buyer: PAN and masked Aadhaar, every deal. Seller: the
#                     vehicle documents, cars and bikes) and the superadmin
#                     or the deal's lender verifies them, within DOCS_DAYS.
#   locked            every document verified. NOW the listing is Reserved
#                     for RESERVATION_DAYS and the buyer applies for the loan
DEAL_AWAITING_SELLER = "awaiting_seller"
DEAL_DOCS_PENDING = "docs_pending"
DEAL_LOCKED = "locked"
DEAL_LOAN_IN_PROGRESS = "loan_in_progress"
DEAL_READY_TO_PAY = "ready_to_pay"
DEAL_PAID = "paid"
DEAL_COMPLETED = "completed"
DEAL_RELEASED = "released"
DEAL_DISPUTED = "disputed"

# A deal in one of these holds the listing: no other buyer can start a deal
# on it. The listing is shown as 'reserved' only from locked onwards.
LIVE_DEAL_STATES = (DEAL_AWAITING_SELLER, DEAL_DOCS_PENDING, DEAL_LOCKED,
                    DEAL_LOAN_IN_PROGRESS, DEAL_READY_TO_PAY, DEAL_PAID, DEAL_DISPUTED)
# "Until the NBFC pays the seller, any deal can be released."
RELEASABLE_STATES = (DEAL_AWAITING_SELLER, DEAL_DOCS_PENDING, DEAL_LOCKED,
                     DEAL_LOAN_IN_PROGRESS, DEAL_READY_TO_PAY)
# The seller has confirmed. From here, cancelling needs the other side to
# agree, or the one asking force-cancels (which counts towards the ban).
# Before confirmation either side can simply back out.
CONFIRMED_STATES = (DEAL_DOCS_PENDING, DEAL_LOCKED, DEAL_LOAN_IN_PROGRESS,
                    DEAL_READY_TO_PAY)
# The 7-day timer only applies until the NBFC marks Ready to pay.
TIMED_STATES = (DEAL_DOCS_PENDING, DEAL_LOCKED, DEAL_LOAN_IN_PROGRESS)

# The deal stage where the buyer must accept the deal warning (buyer_ack_at)
# before the seller can confirm.
BUYER_NOTICE_STATES = (DEAL_AWAITING_SELLER,)

# Loan types. Vehicle for the vehicle categories, personal for the rest.
LOAN_VEHICLE = "vehicle"
LOAN_PERSONAL = "personal"
LOAN_TYPES = (LOAN_VEHICLE, LOAN_PERSONAL)

# Why a deal was released.
RELEASE_BUYER_WITHDREW = "buyer_withdrew"
RELEASE_SELLER_CANCELLED = "seller_cancelled"
RELEASE_SELLER_DECLINED = "seller_declined"        # said no before confirming
RELEASE_SELLER_NO_RESPONSE = "seller_no_response"  # didn't confirm in time
RELEASE_RESERVATION_EXPIRED = "reservation_expired"
RELEASE_ACCOUNT_SUSPENDED = "account_suspended"
RELEASE_STAFF_ACTION = "staff_action"
RELEASE_LOAN_REJECTED = "loan_rejected"
RELEASE_BUYER_NO_RESPONSE = "buyer_no_response"    # didn't accept the warning in time
RELEASE_MUTUAL = "mutual_cancel"                   # one asked, the other agreed
RELEASE_BUYER_FORCE = "buyer_force_cancel"
RELEASE_SELLER_FORCE = "seller_force_cancel"
# Backing out before the seller confirms (buyer_withdrew, seller_declined)
# never counts. After that, only a FORCE cancel counts towards the ban.
SELF_CANCEL_REASONS = (RELEASE_BUYER_WITHDREW, RELEASE_SELLER_CANCELLED)
FORCE_CANCEL_REASONS = (RELEASE_BUYER_FORCE, RELEASE_SELLER_FORCE)

# Documents (buyer's and seller's).
DOC_UPLOADED = "uploaded"
DOC_APPROVED = "approved"
DOC_REJECTED = "rejected"


def _money(value):
    return float(value) if value is not None else None


class DealOffer(db.Model):
    __tablename__ = "deal_offers"
    id = db.Column(db.String(36), primary_key=True, default=gen_id)
    product_id = db.Column(db.String(36), db.ForeignKey("products.id"), nullable=False)
    buyer_id = db.Column(db.String(36), db.ForeignKey("users.id"), nullable=False)
    seller_id = db.Column(db.String(36), db.ForeignKey("users.id"), nullable=False)
    from_user_id = db.Column(db.String(36), db.ForeignKey("users.id"), nullable=False)
    previous_offer_id = db.Column(db.String(36), db.ForeignKey("deal_offers.id"))
    price = db.Column(db.Numeric(12, 2), nullable=False)
    round_number = db.Column(db.Integer, nullable=False, default=1)
    status = db.Column(db.String(20), nullable=False, default=OFFER_OPEN)
    note = db.Column(db.String(500))
    expires_at = db.Column(db.DateTime, nullable=False)
    responded_at = db.Column(db.DateTime)
    # Phase 3 stored here when the buyer ticked the deal warning on this
    # offer. The buyer no longer sees a warning on offers (only the seller
    # does, on confirming), so new offers leave it empty; old rows keep
    # their value. The buyer's acknowledgement is now Deal.buyer_ack_at.
    acknowledged_at = db.Column(db.DateTime)
    created_at = db.Column(db.DateTime, default=datetime.utcnow)
    updated_at = db.Column(db.DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)

    def is_live(self, now=None):
        """Open AND not past its 48 hours. The timer job marks expired offers
        every few minutes; this check means nothing can be accepted in the
        gap between the deadline and the job's next run."""
        now = now or datetime.utcnow()
        return self.status == OFFER_OPEN and self.expires_at > now

    def to_dict(self, viewer_id=None):
        d = {
            "id": self.id,
            "product_id": self.product_id,
            "buyer_id": self.buyer_id,
            "seller_id": self.seller_id,
            "from_user_id": self.from_user_id,
            "previous_offer_id": self.previous_offer_id,
            "price": _money(self.price),
            "round_number": self.round_number,
            # An open offer past its deadline reads as expired straight away,
            # even before the timer job has updated the row.
            "status": OFFER_EXPIRED if (self.status == OFFER_OPEN and not self.is_live())
                      else self.status,
            "note": self.note,
            "from_role": "seller" if self.from_user_id == self.seller_id else "buyer",
            "expires_at": iso_utc(self.expires_at),
            "responded_at": iso_utc(self.responded_at),
            "created_at": iso_utc(self.created_at),
        }
        if viewer_id:
            # What the person looking at this card may do with it, so both
            # clients show the same buttons without re-deriving the rules.
            live = d["status"] == OFFER_OPEN
            is_party = viewer_id in (self.buyer_id, self.seller_id)
            d["can_respond"] = live and is_party and viewer_id != self.from_user_id
            d["can_withdraw"] = live and viewer_id == self.from_user_id
        return d


class Deal(db.Model):
    __tablename__ = "deals"
    id = db.Column(db.String(36), primary_key=True, default=gen_id)
    accepted_offer_id = db.Column(db.String(36), db.ForeignKey("deal_offers.id"),
                                  nullable=False, unique=True)
    product_id = db.Column(db.String(36), db.ForeignKey("products.id"), nullable=False)
    buyer_id = db.Column(db.String(36), db.ForeignKey("users.id"), nullable=False)
    seller_id = db.Column(db.String(36), db.ForeignKey("users.id"), nullable=False)
    agreed_price = db.Column(db.Numeric(12, 2), nullable=False)
    status = db.Column(db.String(20), nullable=False, default=DEAL_LOCKED)
    locked_at = db.Column(db.DateTime, nullable=False)
    reserved_until = db.Column(db.DateTime, nullable=False)
    financer_id = db.Column(db.Integer, db.ForeignKey("financers.financer_id", ondelete="SET NULL"))
    down_payment = db.Column(db.Numeric(12, 2))
    utr = db.Column(db.String(50))
    loan_applied_at = db.Column(db.DateTime)
    ready_to_pay_at = db.Column(db.DateTime)
    down_payment_at = db.Column(db.DateTime)
    buyer_ready_at = db.Column(db.DateTime)
    seller_ready_at = db.Column(db.DateTime)
    paid_at = db.Column(db.DateTime)
    money_received_at = db.Column(db.DateTime)
    vehicle_received_at = db.Column(db.DateTime)
    completed_at = db.Column(db.DateTime)
    released_at = db.Column(db.DateTime)
    released_by = db.Column(db.String(36), db.ForeignKey("users.id", ondelete="SET NULL"))
    release_reason = db.Column(db.String(30))
    release_note = db.Column(db.String(255))
    disputed_at = db.Column(db.DateTime)
    # Phase 3: seller confirmation, documents, loan type, handover code.
    loan_type = db.Column(db.String(20), nullable=False, default=LOAN_VEHICLE)
    confirm_by = db.Column(db.DateTime)
    seller_confirmed_at = db.Column(db.DateTime)
    buyer_ack_at = db.Column(db.DateTime)
    seller_ack_at = db.Column(db.DateTime)
    docs_approved_at = db.Column(db.DateTime)
    vehicle_had_loan = db.Column(db.Boolean)
    handover_code = db.Column(db.String(10))
    handover_code_attempts = db.Column(db.Integer, nullable=False, default=0)
    # Phase 4: an open cancel request. The other side agrees (cancelled, no
    # penalty) or disagrees, the one who asked may force-cancel, and it
    # lapses at cancel_request_expires_at. All four are cleared when the
    # request ends.
    cancel_requested_by = db.Column(db.String(36), db.ForeignKey("users.id", ondelete="SET NULL"))
    cancel_requested_at = db.Column(db.DateTime)
    cancel_request_expires_at = db.Column(db.DateTime)
    cancel_request_reason = db.Column(db.String(255))
    created_at = db.Column(db.DateTime, default=datetime.utcnow)
    updated_at = db.Column(db.DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)

    @property
    def is_live(self):
        return self.status in LIVE_DEAL_STATES

    @property
    def has_cancel_request(self):
        return (self.cancel_requested_by is not None and self.cancel_request_expires_at is not None
                and self.cancel_request_expires_at > datetime.utcnow()
                and self.status in CONFIRMED_STATES)

    def clear_cancel_request(self):
        self.cancel_requested_by = None
        self.cancel_requested_at = None
        self.cancel_request_expires_at = None
        self.cancel_request_reason = None

    def to_dict(self, viewer_id=None):
        d = {
            "id": self.id,
            "accepted_offer_id": self.accepted_offer_id,
            "product_id": self.product_id,
            "buyer_id": self.buyer_id,
            "seller_id": self.seller_id,
            "agreed_price": _money(self.agreed_price),
            "status": self.status,
            "locked_at": iso_utc(self.locked_at),
            "reserved_until": iso_utc(self.reserved_until),
            "financer_id": self.financer_id,
            "down_payment": _money(self.down_payment),
            "utr": self.utr,
            "loan_applied_at": iso_utc(self.loan_applied_at),
            "ready_to_pay_at": iso_utc(self.ready_to_pay_at),
            "down_payment_at": iso_utc(self.down_payment_at),
            "buyer_ready_at": iso_utc(self.buyer_ready_at),
            "seller_ready_at": iso_utc(self.seller_ready_at),
            "paid_at": iso_utc(self.paid_at),
            "money_received_at": iso_utc(self.money_received_at),
            "vehicle_received_at": iso_utc(self.vehicle_received_at),
            "completed_at": iso_utc(self.completed_at),
            "released_at": iso_utc(self.released_at),
            "release_reason": self.release_reason,
            "release_note": self.release_note,
            "disputed_at": iso_utc(self.disputed_at),
            "created_at": iso_utc(self.created_at),
            "loan_type": self.loan_type or LOAN_VEHICLE,
            "confirm_by": iso_utc(self.confirm_by),
            "seller_confirmed_at": iso_utc(self.seller_confirmed_at),
            "buyer_ack_at": iso_utc(self.buyer_ack_at),
            "seller_ack_at": iso_utc(self.seller_ack_at),
            "docs_approved_at": iso_utc(self.docs_approved_at),
            "vehicle_had_loan": self.vehicle_had_loan,
            # From here a cancel needs the other side's agreement (or a
            # force cancel, which counts towards the pause).
            "cancel_needs_agreement": self.status in CONFIRMED_STATES,
            "cancel_request": None,
        }
        req = self.has_cancel_request
        if req:
            d["cancel_request"] = {
                "by_role": "buyer" if self.cancel_requested_by == self.buyer_id else "seller",
                "requested_at": iso_utc(self.cancel_requested_at),
                "expires_at": iso_utc(self.cancel_request_expires_at),
                "reason": self.cancel_request_reason,
            }
        if viewer_id:
            d["my_role"] = ("buyer" if viewer_id == self.buyer_id
                            else "seller" if viewer_id == self.seller_id else None)
            party = d["my_role"] is not None
            # Before the seller confirms: back out at once (no penalty).
            d["can_cancel"] = party and self.status == DEAL_AWAITING_SELLER
            # After: ask the other side (one request at a time).
            d["can_request_cancel"] = party and self.status in CONFIRMED_STATES and not req
            mine = req and self.cancel_requested_by == viewer_id
            d["can_answer_cancel"] = bool(party and req and not mine)
            d["can_withdraw_cancel"] = bool(mine)
            d["can_force_cancel"] = bool(mine)
            # The buyer accepts the deal warning first, then the seller confirms.
            d["waiting_for_buyer_ack"] = (self.status == DEAL_AWAITING_SELLER
                                          and self.buyer_ack_at is None)
            d["can_acknowledge"] = (d["my_role"] == "buyer" and d["waiting_for_buyer_ack"])
            d["can_confirm"] = (d["my_role"] == "seller" and self.status == DEAL_AWAITING_SELLER
                                and self.buyer_ack_at is not None)
            # The handover code is the buyer's alone: the seller types it in
            # at the handover, which proves the buyer was there and agreed.
            if (d["my_role"] == "buyer" and self.handover_code
                    and self.status in (DEAL_DOCS_PENDING, DEAL_LOCKED, DEAL_LOAN_IN_PROGRESS,
                                        DEAL_READY_TO_PAY, DEAL_PAID)):
                d["handover_code"] = self.handover_code
        return d


class DealEvent(db.Model):
    """Append-only timeline. actor_id is None for the system (timers) and,
    from phase 2, for the NBFC."""
    __tablename__ = "deal_events"
    id = db.Column(db.String(36), primary_key=True, default=gen_id)
    deal_id = db.Column(db.String(36), db.ForeignKey("deals.id"), nullable=False)
    event_type = db.Column(db.String(40), nullable=False)
    actor_id = db.Column(db.String(36), db.ForeignKey("users.id", ondelete="SET NULL"))
    event_data = db.Column(db.JSON)
    created_at = db.Column(db.DateTime, default=datetime.utcnow)

    def to_dict(self):
        return {
            "id": self.id,
            "deal_id": self.deal_id,
            "event_type": self.event_type,
            "actor_id": self.actor_id,
            "data": self.event_data or {},
            "created_at": iso_utc(self.created_at),
        }


class LoanStatusEvent(db.Model):
    """One change to a deal-linked loan. source: buyer, staff, system or
    webhook. provider_event_id is the lender's own id for a webhook event;
    a UNIQUE key on (application_id, provider_event_id) drops duplicates."""
    __tablename__ = "loan_status_events"
    id = db.Column(db.String(36), primary_key=True, default=gen_id)
    application_id = db.Column(db.String(36), db.ForeignKey("emi_applications.id", ondelete="CASCADE"),
                               nullable=False)
    deal_id = db.Column(db.String(36), db.ForeignKey("deals.id"))
    status = db.Column(db.String(30), nullable=False)
    note = db.Column(db.String(500))
    source = db.Column(db.String(20), nullable=False, default="staff")
    actor_id = db.Column(db.String(36), db.ForeignKey("users.id", ondelete="SET NULL"))
    provider_event_id = db.Column(db.String(150))
    created_at = db.Column(db.DateTime, default=datetime.utcnow)

    def to_dict(self):
        return {
            "id": self.id,
            "application_id": self.application_id,
            "deal_id": self.deal_id,
            "status": self.status,
            "note": self.note,
            "source": self.source,
            "created_at": iso_utc(self.created_at),
        }


class DealDocument(db.Model):
    """A seller document for a deal (RC, insurance...). One row per type per
    deal; uploading again replaces the file. storage_key is a private
    location, never a public URL. Files are deleted some days after the
    deal closes (rules.DOC_RETENTION_DAYS), when storage_key is cleared and
    deleted_at set; the row stays as the record of what was checked."""
    __tablename__ = "deal_documents"
    id = db.Column(db.String(36), primary_key=True, default=gen_id)
    deal_id = db.Column(db.String(36), db.ForeignKey("deals.id"), nullable=False)
    doc_type = db.Column(db.String(30), nullable=False)
    status = db.Column(db.String(20), nullable=False, default=DOC_UPLOADED)
    storage_key = db.Column(db.String(500))
    file_name = db.Column(db.String(200))
    content_type = db.Column(db.String(100))
    size_bytes = db.Column(db.Integer)
    uploaded_by = db.Column(db.String(36), db.ForeignKey("users.id", ondelete="SET NULL"))
    uploaded_at = db.Column(db.DateTime, default=datetime.utcnow)
    reviewed_by = db.Column(db.String(36), db.ForeignKey("users.id", ondelete="SET NULL"))
    reviewed_at = db.Column(db.DateTime)
    reject_reason = db.Column(db.String(255))
    deleted_at = db.Column(db.DateTime)
    created_at = db.Column(db.DateTime, default=datetime.utcnow)
    updated_at = db.Column(db.DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)

    def to_dict(self):
        return {
            "id": self.id,
            "deal_id": self.deal_id,
            "doc_type": self.doc_type,
            "status": self.status,
            "file_name": self.file_name,
            "content_type": self.content_type,
            "size_bytes": self.size_bytes,
            "uploaded_at": iso_utc(self.uploaded_at),
            "reviewed_at": iso_utc(self.reviewed_at),
            "reject_reason": self.reject_reason,
            "file_deleted": self.deleted_at is not None,
        }


class OtpCode(db.Model):
    """One SMS code. Only an HMAC of the code is stored."""
    __tablename__ = "otp_codes"
    id = db.Column(db.String(36), primary_key=True, default=gen_id)
    user_id = db.Column(db.String(36), db.ForeignKey("users.id", ondelete="CASCADE"), nullable=False)
    purpose = db.Column(db.String(30), nullable=False)
    ref_id = db.Column(db.String(36))
    code_hash = db.Column(db.String(64), nullable=False)
    sent_to = db.Column(db.String(20))
    expires_at = db.Column(db.DateTime, nullable=False)
    attempts = db.Column(db.Integer, nullable=False, default=0)
    consumed_at = db.Column(db.DateTime)
    created_at = db.Column(db.DateTime, default=datetime.utcnow)
