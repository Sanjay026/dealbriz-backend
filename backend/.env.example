# Copy to .env and fill in real values. Never commit the real .env.

# --- Security -------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# The defaults in config.py are placeholders and MUST be replaced before
# going live — anyone who knows them can forge a login token.
SECRET_KEY=b08b386a636cd3f4e0e206f7e3d6c10f1be1244574e20fe4807cd824eca9cf8e
JWT_SECRET_KEY=8b40412faa2de2715f26f8105c55e117d1fa73f27b96793278a0c920b2905a97

# --- Database -------------------------------------------------
# DB_HOST is the compose service name when running under Docker.
DB_USER=dealbridge
DB_PASS=195012
DB_HOST=db
DB_NAME=dealbridge

# Used only by the MySQL container on first boot.
MYSQL_ROOT_PASSWORD=195012

# --- App ------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=/app/logs
UPLOAD_FOLDER=/app/uploads

# Comma-separated list of allowed origins. "*" is convenient locally but
# lets any website call this API with a logged-in user's token — set it to
# your real domain(s) before launch.
CORS_ORIGINS=*

# --- Gunicorn -------------------------------------------------
# Left unset, workers default to (2 x CPU cores) + 1, capped at 8.
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
