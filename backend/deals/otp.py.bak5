"""
SMS one-time codes for DealLock (the seller confirming a deal).

DealBriz makes the 6-digit code itself and keeps only an HMAC of it, so the
check never depends on the SMS company. The SMS company only delivers it.

Settings (.env next to docker-compose.prod.yml):

    OTP_PROVIDER    2factor | msg91 | console
                    console writes the code to the backend log instead of
                    sending an SMS. For testing only: anyone who can read
                    the server logs can read the codes.
                    Not set = OTP is off and confirming a deal is refused
                    with a clear message.
    OTP_API_KEY     the provider's API key (2Factor) or auth key (MSG91)
    OTP_TEMPLATE    2Factor: the OTP template name
                    MSG91:   the template_id of the OTP template
                    Indian SMS needs a DLT-approved template either way.

Rules: a code lasts 10 minutes and works once, 5 wrong tries kill it, a new
code can be sent after 60 seconds, and at most 5 codes per hour per user.
"""
import hashlib
import hmac
import json
import logging
import os
import secrets
import urllib.parse
import urllib.request
from datetime import timedelta

from flask import current_app

from extensions import db
from models import OtpCode

log = logging.getLogger("dealbridge.otp")

CODE_MINUTES = 10
MAX_ATTEMPTS = 5
RESEND_SECONDS = 60
MAX_PER_HOUR = 5

PURPOSE_DEAL_CONFIRM = "deal_confirm"


class OtpError(Exception):
    """A problem the user should see (wrong code, too many tries...)."""

    def __init__(self, message, code=400):
        super().__init__(message)
        self.message = message
        self.code = code


def _provider():
    return (os.environ.get("OTP_PROVIDER") or "").strip().lower()


def is_configured():
    p = _provider()
    if p == "console":
        return True
    if p in ("2factor", "msg91"):
        return bool(os.environ.get("OTP_API_KEY")) and bool(os.environ.get("OTP_TEMPLATE"))
    return False


def normalise_phone(raw):
    """Indian mobile -> 10 digits, or None. Accepts +91, 91, 0 prefixes,
    spaces and dashes."""
    digits = "".join(ch for ch in str(raw or "") if ch.isdigit())
    if len(digits) == 12 and digits.startswith("91"):
        digits = digits[2:]
    elif len(digits) == 11 and digits.startswith("0"):
        digits = digits[1:]
    if len(digits) == 10 and digits[0] in "6789":
        return digits
    return None


def mask_phone(phone10):
    return f"+91 ******{phone10[-4:]}"


def _hash(otp_id, code):
    key = (current_app.config.get("SECRET_KEY") or "").encode()
    return hmac.new(key, f"{otp_id}:{code}".encode(), hashlib.sha256).hexdigest()


def _send_sms(phone10, code):
    """Raises OtpError if the provider refuses. Never logs the code except
    for the console provider."""
    provider = _provider()
    if provider == "console":
        log.warning("OTP (console provider, testing only) for %s: %s", mask_phone(phone10), code)
        return
    key = os.environ.get("OTP_API_KEY", "")
    template = os.environ.get("OTP_TEMPLATE", "")
    try:
        if provider == "2factor":
            # GET https://2factor.in/API/V1/{key}/SMS/{phone}/{otp}/{template}
            # -> {"Status": "Success", "Details": "<session id>"}
            url = "https://2factor.in/API/V1/{}/SMS/{}/{}/{}".format(
                urllib.parse.quote(key, safe=""), phone10, code, urllib.parse.quote(template, safe=""))
            with urllib.request.urlopen(url, timeout=10) as resp:
                body = json.loads(resp.read().decode() or "{}")
            if str(body.get("Status", "")).lower() != "success":
                raise RuntimeError(f"2factor refused: {body.get('Details')}")
        elif provider == "msg91":
            # POST https://control.msg91.com/api/v5/otp?template_id=..&mobile=91..&otp=..
            # header authkey. Errors can come back with HTTP 200 and
            # {"type": "error"}, so the body is checked, not just the status.
            query = urllib.parse.urlencode({"template_id": template, "mobile": "91" + phone10,
                                            "otp": code, "otp_expiry": CODE_MINUTES})
            req = urllib.request.Request(
                "https://control.msg91.com/api/v5/otp?" + query, data=b"{}", method="POST",
                headers={"authkey": key, "Content-Type": "application/json",
                         "Accept": "application/json"})
            with urllib.request.urlopen(req, timeout=10) as resp:
                body = json.loads(resp.read().decode() or "{}")
            if str(body.get("type", "")).lower() != "success":
                raise RuntimeError(f"msg91 refused: {body.get('message')}")
        else:
            raise RuntimeError(f"unknown OTP_PROVIDER {provider!r}")
    except OtpError:
        raise
    except Exception as exc:
        log.error("OTP SMS failed (%s): %s", provider, exc)
        raise OtpError("We couldn't send the SMS just now. Please try again in a minute.", 502)


def send_code(user, purpose, ref_id, now):
    """Creates and sends a code. Returns {"sent_to", "expires_at",
    "resend_after_seconds"}. The caller commits. Raises OtpError."""
    if not is_configured():
        raise OtpError("SMS verification isn't set up on DealBriz yet, so deals can't be "
                       "confirmed right now. Please contact support.", 503)
    phone = normalise_phone(user.phone)
    if not phone:
        raise OtpError("Add a valid 10-digit Indian mobile number to your profile first. "
                       "The code is sent there.", 409)

    last = (OtpCode.query.filter_by(user_id=user.id, purpose=purpose, ref_id=ref_id)
            .order_by(OtpCode.created_at.desc()).first())
    if last and last.created_at and (now - last.created_at).total_seconds() < RESEND_SECONDS:
        wait = RESEND_SECONDS - int((now - last.created_at).total_seconds())
        raise OtpError(f"Please wait {wait} seconds before asking for a new code.", 429)
    hour_ago = now - timedelta(hours=1)
    recent = (OtpCode.query.filter(OtpCode.user_id == user.id, OtpCode.created_at > hour_ago)
              .count())
    if recent >= MAX_PER_HOUR:
        raise OtpError("Too many codes asked for. Please try again in an hour.", 429)

    # Any older unused code for the same thing stops working.
    for old in OtpCode.query.filter_by(user_id=user.id, purpose=purpose, ref_id=ref_id,
                                       consumed_at=None).all():
        old.consumed_at = now

    code = f"{secrets.randbelow(1000000):06d}"
    row = OtpCode(user_id=user.id, purpose=purpose, ref_id=ref_id, code_hash="",
                  sent_to=mask_phone(phone), expires_at=now + timedelta(minutes=CODE_MINUTES),
                  attempts=0, created_at=now)
    db.session.add(row)
    db.session.flush()
    row.code_hash = _hash(row.id, code)
    _send_sms(phone, code)
    return {"sent_to": row.sent_to, "expires_in_minutes": CODE_MINUTES,
            "resend_after_seconds": RESEND_SECONDS}


def check_code(user, purpose, ref_id, code, now):
    """True if right (and uses the code up). Raises OtpError when wrong,
    expired or used up. Wrong tries are counted, so the caller must commit
    even when this raises."""
    code = "".join(ch for ch in str(code or "") if ch.isdigit())
    if len(code) != 6:
        raise OtpError("Enter the 6-digit code from the SMS.", 400)
    row = (OtpCode.query.filter_by(user_id=user.id, purpose=purpose, ref_id=ref_id, consumed_at=None)
           .order_by(OtpCode.created_at.desc()).with_for_update().first())
    if not row:
        raise OtpError("Ask for a code first.", 409)
    if row.expires_at <= now:
        row.consumed_at = now
        raise OtpError("That code has expired. Ask for a new one.", 409)
    if row.attempts >= MAX_ATTEMPTS:
        row.consumed_at = now
        raise OtpError("Too many wrong tries. Ask for a new code.", 409)
    if not hmac.compare_digest(row.code_hash, _hash(row.id, code)):
        row.attempts += 1
        left = MAX_ATTEMPTS - row.attempts
        if left <= 0:
            row.consumed_at = now
            raise OtpError("Wrong code. That was the last try, so ask for a new code.", 400)
        raise OtpError(f"Wrong code. {left} {'try' if left == 1 else 'tries'} left.", 400)
    row.consumed_at = now
    return True
